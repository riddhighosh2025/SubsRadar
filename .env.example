# GEMINI_API_KEY: Required for Gemini / Gemma AI Studio API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Prisma database connection string (SQLite or PostgreSQL)
DATABASE_URL="file:./dev.db"

# OLLAMA_HOST & OLLAMA_MODEL: Optional local Ollama inference endpoint for Gemma 4 (E2B / E4B)
OLLAMA_HOST="http://127.0.0.1:11434"
OLLAMA_MODEL="gemma4:e4b"

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens for user authentication
JWT_SECRET="subsradar-local-privacy-jwt-secret-2026"


